# ---------------------------------------------------------------------------
# Core system packages (~344 MB)
# ---------------------------------------------------------------------------
RUN set -eux; \
    if [ -n "${APT_MIRROR_HOST}" ]; then \
        cp /etc/apt/sources.list /etc/apt/sources.list.orig; \
        sed -i -E -e "s;//([^/]*\.)?(ubuntu\.com|debian\.org);//${APT_MIRROR_HOST};g" /etc/apt/sources.list; \
    fi; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        tzdata \
        locales \
        ca-certificates \
        software-properties-common \
        openssh-client \
        wget curl \
        vim nano \
        git \
        unzip zip tar gzip \
        tree htop \
        iputils-ping telnet net-tools lsof netcat-openbsd nmap \
        file less rsync lsyncd \
        procps psmisc coreutils util-linux sudo gettext \
        grep sed gawk jq ripgrep \
        tmux \
        gh \
        python3 python3-pip python3-tk python3-dev \
        nginx; \
    if [ "$REGION" = "china-north-lf" ]; then \
        /bin/cp -f /usr/share/zoneinfo/PRC /etc/localtime && echo "PRC" > /etc/timezone; \
    fi; \
    rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Desktop / VNC / GUI packages (~760 MB)
# ---------------------------------------------------------------------------
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ffmpeg imagemagick \
        tigervnc-standalone-server x11-xserver-utils \
        x11-utils \
        xdotool xclip \
        openbox \
        tilix \
        gnome-screenshot \
        autocutsel \
        libxv1 \
        fontconfig \
        gcc build-essential make pkg-config \
        cmake ninja-build \
        libcairo2-dev libffi-dev libpango1.0-dev freeglut3-dev; \
    rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# CJK / IME support (~286 MB)
# ---------------------------------------------------------------------------
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        dbus dbus-x11 \
        fcitx5 \
        fcitx5-chinese-addons \
        fcitx5-frontend-gtk3 \
        fcitx5-frontend-qt5; \
