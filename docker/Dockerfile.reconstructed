# ---- Stage: uv (provides /uv, /uvx) ----
FROM ghcr.io/astral-sh/uv:latest AS uv-stage

# ---- Stage: python-server-builder (provides /wheels/*.whl) ----
# In the original build, this stage builds python-server wheels.
# Here we create a minimal stub so the Dockerfile is syntactically valid.
FROM python:3.12-slim AS python-server-builder
RUN mkdir -p /wheels && \
    pip wheel --no-deps --wheel-dir /wheels pip

# ---- Stage: python-server-requirements (provides /app/requirements.txt) ----
FROM python:3.12-slim AS python-server-requirements
RUN mkdir -p /app && echo "# placeholder" > /app/requirements.txt

# ---- Stage: node-runtime-builder (provides /root/sandbox/runtime/node/node_modules) ----
FROM node:22-slim AS node-runtime-builder
RUN mkdir -p /root/sandbox/runtime/node/node_modules

# =============================================================================
# Main image
# =============================================================================
FROM ubuntu:22.04

# ---------------------------------------------------------------------------
# Browser kernel stage args & base browser deps
# ---------------------------------------------------------------------------
ARG REGION=china-north-lf
ARG TARGETARCH=amd64
ARG APT_MIRROR_HOST=
ARG BROWSER_SOURCE=rs
ARG CUSTOM_BROWSER_KERNEL=

ENV DEBIAN_FRONTEND=noninteractive

RUN set -eux; \
    if [ -n "${APT_MIRROR_HOST}" ]; then \
        cp /etc/apt/sources.list /etc/apt/sources.list.orig; \
        sed -i -E -e "s;//([^/]*\.)?(ubuntu\.com|debian\.org);//${APT_MIRROR_HOST};g" /etc/apt/sources.list; \
    fi; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        unzip \
        libasound2 \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libatspi2.0-0 \
        libcairo2 \
        libcups2 \
        libdbus-1-3 \
        libdrm2 \
        libgbm1 \
        libglib2.0-0 \
        libnspr4 \
        libnss3 \
        libpango-1.0-0 \
        libwayland-client0 \
        libx11-6 \
        libxcb1 \
        libxcomposite1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxkbcommon0 \
        libxrandr2 \
        fonts-liberation \
        libgtk-3-0 \
        libvulkan1 \
        wget \
        xdg-utils && \
    rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Install Chromium browser via browser-ctl script (~372 MB)
# ---------------------------------------------------------------------------
COPY browser-kernel/browser-ctl.sh /opt/gem/browser-ctl.sh

RUN set -eux; \
    chmod +x /opt/gem/browser-ctl.sh; \
    case "${REGION}" in \
      "china-north-lf"|"") URL_PREFIX="https://lf3-static.bytednsdoc.com/obj/eden-cn/100upeupq/" ;; \
      "aliyun_sg") URL_PREFIX="https://sf16-sg.tiktokcdn.com/obj/eden-sg/100upeupq/" ;; \
      "aliyun_va") URL_PREFIX="https://sf16-va.tiktokcdn.com/obj/eden-va2/100upeupq/" ;; \
      "us-east"|"us-east-red") URL_PREFIX="https://sf16-va.tiktokcdn.com/obj/eden-va2/100upeupq/" ;; \
      *) URL_PREFIX="https://lf3-static.bytednsdoc.com/obj/eden-cn/100upeupq/" ;; \
    esac; \
    TARGETARCH="${TARGETARCH}" ASSET_PREFIX="${URL_PREFIX}" CUSTOM_BROWSER_KERNEL="${CUSTOM_BROWSER_KERNEL}" \
        /opt/gem/browser-ctl.sh install ${BROWSER_SOURCE}

COPY browser-kernel/chromium-browser.desktop /usr/share/applications/chromium-browser.desktop
RUN update-desktop-database /usr/share/applications 2>/dev/null || true

