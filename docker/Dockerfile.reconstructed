# Additional region/build args for the main image
ARG REGION=china-north-lf
ARG APT_MIRROR_HOST=
ARG TARGETARCH=amd64
ARG INSTALL_HEAVY_FONTS=true
ARG DISABLE_MCP_SERVER=true
ARG PIP_INDEX_URL=https://bytedpypi.byted.org/simple
ARG UV_DEFAULT_INDEX=https://bytedpypi.byted.org/simple

ENV DEBIAN_FRONTEND=noninteractive \
